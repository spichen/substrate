+// Startup and wakeup probes may need egress before the worker reports readiness.
+// Assignment is required during resume; inactive and unknown states stay denied.
+fn actor_can_egress(status: Option<&protos::ateapi::ActorStatus>) -> bool {
+	let Some(status) = status else {
+		return false;
+	};
+	match protos::ateapi::ActorState::try_from(status.state) {
+		Ok(protos::ateapi::ActorState::Running) => true,
+		Ok(protos::ateapi::ActorState::Resuming) => status
+			.worker_assignment
+			.as_ref()
+			.is_some_and(|assignment| !assignment.worker_pod_ip.is_empty()),
+		_ => false,
+	}
+}
